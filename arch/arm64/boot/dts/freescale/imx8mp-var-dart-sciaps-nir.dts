			MX8MP_IOMUXC_NAND_DATA00__GPIO3_IO06			0x16 // CSI2_RST: Fast slew rate, drivestrength x6
			MX8MP_IOMUXC_NAND_DATA03__GPIO3_IO09			0x16 // CSI2_PWDN: Fast slew rate, drivestrength x6
			MX8MP_IOMUXC_NAND_DATA02__GPIO3_IO08			0x16 // CSI0_MCLK_EN: Fast slew rate, drivestrength x6
			//MX8MP_IOMUXC_NAND_DATA02__GPIO3_IO08			0x146 // CSI0_MCLK_EN: weak pullup enabled, drivestrength x6
