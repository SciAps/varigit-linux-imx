	pinctrl_brcm_spect_gpios: brcmspectgrp {
		fsl,pins = <
			MX8MP_IOMUXC_ENET_RD3__GPIO1_IO29				0x16 // Loop back SPI_nCS Interrupt: weak pullup enabled, Fast slew rate, drivestrength x6
			MX8MP_IOMUXC_ENET_MDIO__GPIO1_IO17				0x16 // GPIO117/CS_GPIO as nCS0: weak pullup enabled, Fast slew rate, drivestrength x6
			MX8MP_IOMUXC_SAI2_TXFS__GPIO4_IO24				0x16 // DPP_UART_SEL_nPROG as nCS1: weak pullup enabled, Fast slew rate, drivestrength x6
			MX8MP_IOMUXC_SAI2_RXD0__GPIO4_IO23				0x16 // SOM_DPP_JTAG_EN as nCS2: weak pullup enabled, Fast slew rate, drivestrength x6
			MX8MP_IOMUXC_SAI2_RXC__GPIO4_IO22				0x156 // DPP_nUART_SPI: weak pullup enabled, Fast slew rate, drivestrength x6
		>;
	};

