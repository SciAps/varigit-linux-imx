	pinctrl_gnss_gpios: gnssgrp {
		fsl,pins = <
			MX8MP_IOMUXC_HDMI_DDC_SCL__GPIO3_IO26			0x16 // GPS_EXTINT: Fast slew rate, drivestrength x6
			MX8MP_IOMUXC_HDMI_DDC_SDA__GPIO3_IO27			0x36 // GPS_nRST: Open Drain Enabled, Fast slew rate, drivestrength x6
		>;
