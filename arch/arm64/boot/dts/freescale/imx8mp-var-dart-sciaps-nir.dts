			MX8MP_IOMUXC_ECSPI1_MISO__ECSPI1_MISO				0x16
			MX8MP_IOMUXC_ECSPI1_SS0__GPIO5_IO09					0x16 // disable pullup//0x146 // SPI1_CS_PERIF: weak pullup enabled, drivestrength x6
		>;
	};

	pinctrl_mipi_dsi_reset: mipidsigrp {
		fsl,pins = <
			MX8MP_IOMUXC_GPIO1_IO06__GPIO1_IO06				0x16 // LCD nRst: pulled down on schematics , Fast slew rate, drivestrength x6
		>;
	};

	pinctrl_captouch: captouchgrp {
		fsl,pins = <
			MX8MP_IOMUXC_SAI2_TXC__GPIO4_IO25				0x16  // Touch nRst: weak pulldown enabled, drivestrength x6
			MX8MP_IOMUXC_ENET_TD0__GPIO1_IO21				0x16  // Touch nInt: weak pullup enabled, drivestrength x6
		>;
	};

	pinctrl_gpio_keys: keysgrp {
		fsl,pins = <
			MX8MP_IOMUXC_ENET_TD1__GPIO1_IO20				0x146 // ONOFF Button: weak pullup enabled, drivestrength x6
